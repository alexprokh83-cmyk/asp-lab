# Public values only. Never put a Telegram bot token here or anywhere in this project.
SITE_MODE=preview
PUBLIC_SITE_URL=
PUBLIC_TELEGRAM_URL=https://t.me/ASP_Lab_Bot
PUBLIC_GITHUB_URL=https://github.com/alexprokh-asp
# Public same-origin route; embedded into the static HTML at build time. Not a secret.
PUBLIC_ASP_FIND_PROXY_URL=/api/asp-automation-finder
# Server-only upstream destination: test for Vercel Preview, production URL for Vercel Production.
ASP_FINDER_N8N_WEBHOOK_URL=https://n8n.pravkazak.org.ua/webhook-test/asp-automation-finder
# Server-only Vercel Function settings. Set test URL in Preview and production URL in Production.
ASP_CONTACT_N8N_WEBHOOK_URL=https://n8n.pravkazak.org.ua/webhook-test/asp-contact
# Server-only credential shared with the Finder Header Auth workflow; never expose this value publicly.
ASP_FINDER_N8N_HEADER_KEY=
PUBLIC_OPERATOR_NAME=
PUBLIC_PRIVACY_CONTACT=
PUBLIC_HOSTING_PROVIDER=

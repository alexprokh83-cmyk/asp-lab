---
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/translations/index";
import { namedRoute } from "../../lib/routes";
import { solutionsCopy } from "../../content/pages/solutions";
import { projectById } from "../../content/projects";
import { directionsCopy } from "../../content/pages/directions";
import { projectsSectionCopy } from "../../content/pages/projects-section";
import ProjectCard from "../ProjectCard.astro";
import Faq from "../Faq.astro";
import CtaBand from "./CtaBand.astro";
import ScenarioGrid from "./ScenarioGrid.astro";
import StagePath from "./StagePath.astro";
import DemonstrateBlock from "./DemonstrateBlock.astro";
import { strategyCopy } from "../../content/pages/strategy";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const c = solutionsCopy[locale];
const st = strategyCopy[locale];
const dc = directionsCopy[locale];
const ps = projectsSectionCopy[locale];
---
<section class="section sec-dirs" aria-labelledby="dirs-title">
  <div class="container">
    <h2 id="dirs-title" class="sr-only">{dc.heading}</h2>
    <nav class="jump jump--8" aria-label={dc.heading}>
      <ul>
        {dc.items.map((d, i) => <li><a href={`#${d.id}`}><span class="mono">0{i + 1}</span> {ps.categories[d.id]}</a></li>)}
      </ul>
    </nav>
    {dc.items.map((d, i) => (
      <>
      {/* legacy anchors, kept OUTSIDE the grid so they do not take a grid cell */}
      {d.id === "integrations" && <span id="automation"></span>}
      {d.id === "evaluation" && <span id="model-selection"></span>}
      <article class="dir" id={d.id} aria-labelledby={`${d.id}-title`}>
        <div class="dir__head">
          <p class="dir__num mono" aria-hidden="true">0{i + 1}</p>
          <h2 id={`${d.id}-title`}>{ps.categories[d.id]}</h2>
          <p class="dir__when"><strong>{dc.labels.problem}.</strong> {d.problem}</p>
          <p class="dir__when"><strong>{dc.labels.automate}.</strong> {d.automate}</p>
          <a class="btn btn--primary" href={namedRoute("contact", locale)}>{dc.labels.discuss}<span class="sr-only">: {ps.categories[d.id]}</span></a>
        </div>
        <div class="dir__body">
          <section class="dir__scn">
            <h3>{dc.labels.scenarios}</h3>
            <ul>{d.scenarios.map((x) => <li>{x}</li>)}</ul>
          </section>
          <h3 class="dir__ex">{dc.labels.examples}</h3>
          <div class="grid-2 dir__projects">{d.projectIds.map((id) => <ProjectCard locale={locale} project={projectById(id)!} compact />)}</div>
        </div>
      </article>
      </>
    ))}
  </div>
</section>

<section class="section" id="scenarios" aria-labelledby="scn-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="scn-title">{st.scenarios.heading}</h2>
      <p class="section-heading__lead">{st.scenarios.lead}</p>
    </div>
    <p class="callout callout--warn">{st.scenarios.disclosure}</p>
    <ScenarioGrid locale={locale} />
    <div class="demo-cont">
      <h3>{st.contentAutomation.heading}</h3>
      <p>{st.contentAutomation.text}</p>
      <ol class="scn__flow">{st.contentAutomation.flow.map((f) => <li>{f}</li>)}</ol>
    </div>
  </div>
</section>

<section class="section sec-formats" aria-labelledby="formats-title">
  <div class="container">
    <div class="section-heading"><h2 id="formats-title">{c.formats.heading}</h2><p class="section-heading__lead">{c.formats.lead}</p></div>
    <ol class="formats">
      {c.formats.items.map((f) => (
        <li class="format"><span class="format__tag mono" aria-hidden="true">{f.tag}</span><h3>{f.title}</h3><p>{f.text}</p></li>
      ))}
    </ol>
    <p class="note">{c.formats.note}</p>
    <p><a href={namedRoute("approach", locale)}>{dict.home.process.link}</a></p>
  </div>
</section>

<section class="section sec-layer2" id="path" aria-labelledby="path-title">
  <div class="container">
    <div class="positioning">
      <h2 id="path-title">{st.positioning.heading}</h2>
      <p>{st.positioning.text}</p>
    </div>
    <h3 class="mono-heading path-h">{st.path.heading}</h3>
    <p class="section-heading__lead">{st.path.lead}</p>
    <StagePath locale={locale} />
    <p class="note">{st.path.note}</p>
    <div class="demo-wrap">
      <h2 class="h2-sub">{st.demonstrate.heading}</h2>
      <p class="section-heading__lead">{st.demonstrate.lead}</p>
      <DemonstrateBlock locale={locale} />
    </div>
  </div>
</section>

<section class="section sec-deliv" aria-labelledby="deliv-title">
  <div class="container">
    <div class="section-heading"><h2 id="deliv-title">{c.deliverables.heading}</h2><p class="section-heading__lead">{c.deliverables.lead}</p></div>
    <ul class="chips">{c.deliverables.items.map((x) => <li>{x}</li>)}</ul>
  </div>
</section>

<section class="section sec-bounds dark-section" aria-labelledby="bounds-title">
  <div class="container">
    <div class="section-heading"><h2 id="bounds-title">{c.boundaries.heading}</h2><p class="section-heading__lead">{c.boundaries.lead}</p></div>
    <ul class="bounds">{c.boundaries.items.map((x) => <li><span aria-hidden="true">—</span> {x}</li>)}</ul>
  </div>
</section>

<section class="section sec-faq" aria-labelledby="sfaq-title">
  <div class="container sec-faq__grid"><h2 id="sfaq-title">{c.faq.heading}</h2><Faq items={c.faq.items} /></div>
</section>

<CtaBand locale={locale} />

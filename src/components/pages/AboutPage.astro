---
import type { Locale } from "../../lib/i18n";
import { aboutCopy } from "../../content/pages/about";
import { capabilities } from "../../content/capabilities";
import CapabilityStatus from "../CapabilityStatus.astro";
import CtaBand from "./CtaBand.astro";
import StrategicGoals from "./StrategicGoals.astro";
import { strategyCopy } from "../../content/pages/strategy";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = aboutCopy[locale];
const goals = strategyCopy[locale].goals;
const groups = (["confirmed", "developing", "planned"] as const).map((m) => ({ m, items: capabilities.filter((x) => x.maturity === m) }));
---
<section class="section" aria-labelledby="ab-purpose">
  <div class="container sec-about__grid">
    <h2 id="ab-purpose">{c.purpose.heading}</h2>
    <p class="sec-about__text">{c.purpose.text}</p>
  </div>
</section>

<section class="section sec-goals" aria-labelledby="ab-goals">
  <div class="container">
    <div class="section-heading"><h2 id="ab-goals">{goals.heading}</h2><p class="section-heading__lead">{goals.lead}</p></div>
    <StrategicGoals locale={locale} />
  </div>
</section>

<section class="section sec-formats" aria-labelledby="ab-principles">
  <div class="container sec-about__grid">
    <h2 id="ab-principles">{c.principles.heading}</h2>
    <ul class="plain">{c.principles.items.map((i) => <li>{i}</li>)}</ul>
  </div>
</section>

<section class="section sec-author" aria-labelledby="ab-author">
  <div class="container">
    <div class="section-heading"><h2 id="ab-author">{c.author.heading}</h2></div>
    <article class="author-card">
      <div class="author-card__profile">
        <img class="author-card__photo" src="/images/alex-prokhoda.webp" alt={c.author.photoAlt} width="1049" height="1024" loading="lazy" decoding="async" />
        <div class="author-card__identity">
          <h3>{c.author.name}</h3>
          <p class="author-card__role">{c.author.role}</p>
          <ul class="author-card__socials" aria-label={c.author.socialProfilesLabel}>
            <li>
              <a href="https://www.linkedin.com/in/alex-prokhoda/" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM8.02 18.74H5.05V9.18h2.97v9.56ZM6.54 7.87a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm12.2 10.87h-2.96v-4.65c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.48V9.18h2.84v1.3h.04c.4-.75 1.36-1.55 2.8-1.55 3 0 3.58 1.98 3.58 4.56v5.25Z"/></svg>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href="https://github.com/alexprokh-asp" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.04c-3.1.67-3.75-1.32-3.75-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.7 2.6 1.2 3.23.92.1-.72.39-1.2.7-1.48-2.48-.28-5.08-1.24-5.08-5.51 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.12 2.95.71.78 1.14 1.77 1.14 2.99 0 4.28-2.6 5.22-5.09 5.5.4.35.75 1.02.75 2.06V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg>
                <span>GitHub</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="author-card__bio">
        {c.author.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p>{c.author.shareLead} <a href="https://www.linkedin.com/in/alex-prokhoda/" target="_blank" rel="noopener noreferrer">{c.author.linkedinText}</a>.</p>
      </div>
    </article>
  </div>
</section>

<section class="section" aria-labelledby="ab-found">
  <div class="container sec-about__grid"><h2 id="ab-found">{c.foundations.heading}</h2><p class="sec-about__text">{c.foundations.text}</p></div>
</section>

<section class="section sec-future" aria-labelledby="ab-caps">
  <div class="container">
    <div class="section-heading"><h2 id="ab-caps">{c.capabilities.heading}</h2><p class="section-heading__lead">{c.capabilities.lead}</p></div>
    <div class="grid-3">
      {groups.map((g) => (
        <div class="epanel"><h3><CapabilityStatus locale={locale} maturity={g.m} /></h3><ul class="plain">{g.items.map((x) => <li>{x.label[locale]}</li>)}</ul></div>
      ))}
    </div>
  </div>
</section>


<CtaBand locale={locale} />

<style>
  .sec-author { background: var(--color-surface); }
  .author-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.8fr);
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    background: var(--color-background);
    box-shadow: var(--shadow-card);
  }
  .author-card__profile { display: grid; justify-items: center; gap: var(--space-5); min-width: 0; }
  .author-card__photo {
    display: block;
    width: min(100%, 240px);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 30%;
    border: 4px solid var(--color-blue-50);
    border-radius: 20px;
    box-shadow: 0 10px 28px rgb(15 23 42 / .12);
  }
  .author-card__identity { width: 100%; text-align: center; }
  .author-card__identity h3 { color: var(--color-navy-900); font-size: 22px; line-height: 28px; overflow-wrap: anywhere; }
  .author-card__role { margin-top: 4px; color: var(--color-text-secondary); }
  .author-card__socials { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin: var(--space-4) 0 0; padding: 0; list-style: none; }
  .author-card__socials a { display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 7px 11px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-blue-700); background: var(--color-background); font-size: 14px; font-weight: 500; text-decoration: none; transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease; }
  .author-card__socials a:hover { color: var(--color-blue-800); border-color: var(--color-blue-200); background: var(--color-blue-50); }
  .author-card__socials svg { width: 17px; height: 17px; flex: 0 0 17px; }
  .author-card__bio { display: grid; gap: var(--space-4); min-width: 0; }
  .author-card__bio p { max-width: 65ch; line-height: 1.7; overflow-wrap: anywhere; }
  .author-card__bio a { font-weight: 500; }
  @media (max-width: 767px) {
    .author-card { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); padding: var(--space-5); }
    .author-card__photo { width: min(100%, 200px); }
    .author-card__bio { gap: var(--space-3); }
  }
</style>

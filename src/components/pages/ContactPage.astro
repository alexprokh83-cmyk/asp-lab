---
/**
 * V1 contact page: Telegram-first information page, NOT a form.
 * FUTURE EXTENSION POINT (see docs/future-contact.md): a reviewed, accessible form posting to an n8n webhook
 * would be mounted in the marked slot below once features.contactForm is enabled. Nothing is built here on purpose.
 */
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/translations/index";
import { namedRoute } from "../../lib/routes";
import TelegramCTA from "../TelegramCTA.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---
<section class="section" aria-labelledby="ct-main">
  <div class="container sec-about__grid">
    <div>
      <h2 id="ct-main">{dict.contact.checklistHeading}</h2>
      <ol class="plain plain--num">{dict.contact.checklistItems.map((i) => <li>{i}</li>)}</ol>
    </div>
    <div class="ct-actions">
      <TelegramCTA locale={locale} label={dict.home.finalCta.cta} showContactLink={false} />
      <p class="callout callout--warn">{dict.contact.warning}</p>
      <p><a href={namedRoute("privacy", locale)}>{dict.footer.links.privacy}</a></p>
      {/* FUTURE-CONTACT-FORM-SLOT: intentionally empty in V1 */}
    </div>
  </div>
</section>

---
import type { Locale } from "../../lib/i18n";
import { privacyCopy } from "../../content/pages/privacy";
import { OPERATOR_NAME, PRIVACY_CONTACT, HOSTING_PROVIDER } from "../../config/site";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = privacyCopy[locale];
// Shown only when the owner has supplied the value; nothing is rendered for unknown ones.
const facts = ([[c.pending[0]!, OPERATOR_NAME], [c.pending[2]!, PRIVACY_CONTACT], [c.pending[3]!, HOSTING_PROVIDER]] as [string, string | null][]).filter((f): f is [string, string] => !!f[1]);
---
<section class="section">
  <div class="container page-prose">
    {c.sections.map((s) => (
      <section class="cs-block"><h2>{s.heading}</h2><ul class="plain">{s.items.map((i) => <li>{i}</li>)}</ul></section>
    ))}
    {facts.length > 0 && (
      <section class="cs-block">
        <h2>{c.contactHeading}</h2>
        <dl class="facts">{facts.map(([label, value]) => <><dt>{label}</dt><dd>{value}</dd></>)}</dl>
      </section>
    )}
  </div>
</section>

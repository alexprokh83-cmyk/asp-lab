---
import type { Locale } from "../../lib/i18n";
import { approachCopy } from "../../content/pages/approach";
import { projectById } from "../../content/projects";
import type { Project } from "../../content/project-types";
import { namedRoute } from "../../lib/routes";
import CtaBand from "./CtaBand.astro";
import StagePath from "./StagePath.astro";
import { strategyCopy } from "../../content/pages/strategy";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = approachCopy[locale];
const st = strategyCopy[locale];
const examples = [
  projectById("jira-to-github-migration"),
  projectById("local-transcription"),
].filter((project): project is Project => project !== null && Boolean(project.text[locale].result));
---
<section class="section" aria-labelledby="ap-base">
  <div class="container sec-about__grid">
    <div><h2 id="ap-base">{c.baseline.heading}</h2><p class="section-heading__lead">{c.baseline.lead}</p></div>
    <ol class="plain plain--num">{c.baseline.items.map((i) => <li>{i}</li>)}</ol>
  </div>
</section>

<section class="section sec-layer2" aria-labelledby="ap-method">
  <div class="container">
    <div class="section-heading"><h2 id="ap-method">{c.method.heading}</h2><p class="section-heading__lead">{c.method.lead}</p></div>
    <StagePath locale={locale} />
    <p class="note">{st.path.note}</p>
  </div>
</section>

<section class="section" aria-labelledby="ap-test">
  <div class="container">
    <div class="section-heading"><h2 id="ap-test">{c.testing.heading}</h2><p class="section-heading__lead">{c.testing.lead}</p></div>
    <div class="grid-3">{c.testing.items.map((i) => <article class="acard acard--plain"><h3>{i.title}</h3><p>{i.text}</p></article>)}</div>
    <div class="callout callout--info"><h3 class="h2-sub">{c.human.heading}</h3><p>{c.human.text}</p></div>
  </div>
</section>

<section class="section sec-formats" aria-labelledby="ap-record">
  <div class="container sec-about__grid">
    <div><h2 id="ap-record">{c.record.heading}</h2><p class="section-heading__lead">{c.record.lead}</p></div>
    <ol class="plain plain--num">{c.record.items.map((i) => <li>{i}</li>)}</ol>
  </div>
</section>

<section class="section" aria-labelledby="ap-evidence">
  <div class="container">
    <div class="section-heading"><h2 id="ap-evidence">{c.evidence.heading}</h2><p class="section-heading__lead">{c.evidence.lead}</p></div>
    <div class="grid-2">
      {examples.map((project) => {
        const tx = project.text[locale];
        return <article class="acard acard--plain approach__example">
          <h3>{tx.name ?? tx.title}</h3>
          <p>{tx.subtitle}</p>
          {tx.result && <p class="approach__result">{tx.result}</p>}
          <a href={namedRoute(project.routeKey, locale)}>{c.evidence.link}</a>
        </article>;
      })}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="ap-decision">
  <div class="container">
    <div class="section-heading"><h2 id="ap-decision">{c.decision.heading}</h2><p class="section-heading__lead">{c.decision.lead}</p></div>
    <div class="grid-3">{c.decision.items.map((i) => <article class="acard acard--plain"><h3>{i.title}</h3><p>{i.text}</p></article>)}</div>
  </div>
</section>

<section class="section sec-future" aria-labelledby="ap-pilot">
  <div class="container sec-about__grid">
    <div><h2 id="ap-pilot">{c.pilot.heading}</h2><p class="section-heading__lead">{c.pilot.lead}</p></div>
    <ul class="plain">{c.pilot.items.map((i) => <li>{i}</li>)}</ul>
  </div>
</section>
<CtaBand locale={locale} />

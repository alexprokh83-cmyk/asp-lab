---
/**
 * Homepage — one template for all locales. Section order is fixed by the spec:
 * Hero · Solutions · Projects · Local AI · Audiences · Evidence · Process · About · FAQ · Final CTA
 */
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/translations/index";
import { namedRoute } from "../../lib/routes";
import { featuredProjects } from "../../content/projects";
import { projectsSectionCopy } from "../../content/pages/projects-section";
import TelegramCTA from "../TelegramCTA.astro";
import ProjectCard from "../ProjectCard.astro";
import Faq from "../Faq.astro";
import HomeHero from "./HomeHero.astro";
import StrategicGoals from "../pages/StrategicGoals.astro";
import { strategyCopy } from "../../content/pages/strategy";
import { scenarios } from "../../content/scenarios";
import { directionsCopy } from "../../content/pages/directions";
import { projectById } from "../../content/projects";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const st = strategyCopy[locale];
const h = dict.home;
const ps = projectsSectionCopy[locale];
const dc = directionsCopy[locale];
const r = (k: Parameters<typeof namedRoute>[0]) => namedRoute(k, locale);

const icons: Record<string, string> = {
  documents: "M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5",
  requests: "M4 6h16v12H4zM4 7l8 6 8-6",
  voice: "M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM6 11a6 6 0 0 0 12 0M12 17v4",
  assistants: "M4 5h16v11H9l-5 4zM8 9h8M8 12h5",
  knowledge: "M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM8 8h7M8 11h7",
  integrations: "M5 6h5v5H5zM14 13h5v5h-5zM10 8.5h4a2 2 0 0 1 2 2V13",
  qa: "M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4",
  evaluation: "M5 20V10M12 20V4M19 20v-7",
};

const processSteps = Object.values(h.process.steps);
const solutionsCarouselLabels = {
  ru: { previous: "Предыдущие услуги", next: "Следующие услуги" },
  uk: { previous: "Попередні послуги", next: "Наступні послуги" },
  en: { previous: "Previous services", next: "Next services" },
}[locale];
const projectCarouselLabels = {
  ru: { pagination: "Навигация по проектам", slide: "Перейти к проекту", previous: "Предыдущий проект", next: "Следующий проект" },
  uk: { pagination: "Навігація проєктами", slide: "Перейти до проєкту", previous: "Попередній проєкт", next: "Наступний проєкт" },
  en: { pagination: "Project pagination", slide: "Go to project", previous: "Previous project", next: "Next project" },
}[locale];
const scenarioImagesById: Record<string, string> = {
  "knowledge-assistant": "/images/scenarios/01_Internal_AI_Knowledge_Assistant_новый размер.jpg",
  "request-routing": "/images/scenarios/02_Electronic_Reception_and_Smart_Request_Routing_новый размер.jpg",
  "document-routing": "/images/scenarios/03_Smart_Routing_of_Incoming_Documents_новый размер.jpg",
  "document-drafting": "/images/scenarios/04_AI_Document_Drafting_and_Preparation_новый размер.jpg",
  "meeting-processing": "/images/scenarios/05_AI_Meeting_Processing_and_Transcription_новый размер.jpg",
  "task-tracking": "/images/scenarios/06_AI_Task_and_Action_Item_Tracking_новый размер.jpg",
  "correspondence-analysis": "/images/scenarios/07_AI_Analysis_of_Organizational_Correspondence_новый размер.jpg",
  "consistency-review": "/images/scenarios/08_AI_Document_Consistency_and_Compliance_Check_новый размер.jpg",
};
---
<HomeHero locale={locale} />

<!-- SOLUTIONS -->
<section class="section sec-solutions" aria-labelledby="solutions-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="solutions-title">{h.solutions.heading}</h2>
      <p class="section-heading__lead">{h.solutions.lead}</p>
      <p class="home-pos">{st.positioning.text}</p>
    </div>
    <div class="solutions-carousel" data-solutions-carousel>
      <div class="solutions-carousel__layout">
        <button class="solutions-carousel__button" type="button" data-carousel-prev aria-label={solutionsCarouselLabels.previous}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <div class="solutions-carousel__track" data-carousel-track role="region" aria-label={h.solutions.heading} tabindex="0">
          {dc.items.map((d, index) => (
            <article class="scard" role="group" aria-roledescription="slide" aria-label={`${index + 1} / ${dc.items.length}`}>
              <div class="scard__top">
                <span class="scard__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[d.id]} /></svg>
                </span>
              </div>
              <h3>{ps.categories[d.id]}</h3>
              <p class="scard__problem">{d.problem}</p>
              <p class="scard__examples"><strong>{dc.labels.examples}:</strong> {d.projectIds.slice(0, 2).map((id) => { const x = projectById(id)!.text[locale]; return x.name ?? x.title; }).join(", ")}</p>
              <a class="scard__overlay-link" href={`${r("solutions")}#${d.id}`} aria-label={`${dc.labels.details}: ${ps.categories[d.id]}`}></a>
            </article>
          ))}
        </div>
        <button class="solutions-carousel__button" type="button" data-carousel-next aria-label={solutionsCarouselLabels.next}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
    <div class="home-scn">
      <h3 class="home-scn__heading">{st.scenarios.chipsLabel}</h3>
      <div class="scenario-tabs" data-scenario-tabs>
        <div class="scenario-tabs__list" role="tablist" aria-label={st.scenarios.chipsLabel} aria-orientation="vertical">
          {scenarios.map((x, index) => (
            <button
              class:list={["scenario-tabs__tab", index === 0 && "is-active"]}
              id={`scenario-tab-${x.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`scenario-panel-${x.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-scenario-tab
            >
              {x.copy[locale].title}
            </button>
          ))}
        </div>
        <div class="scenario-tabs__panels">
          {scenarios.map((x, index) => (
            <section
              class="scenario-tabs__panel"
              id={`scenario-panel-${x.id}`}
              role="tabpanel"
              aria-labelledby={`scenario-tab-${x.id}`}
              tabindex="0"
              data-scenario-panel
              hidden={index !== 0}
            >
              <div class="scenario-tabs__visual">
                <img
                  src={encodeURI(scenarioImagesById[x.id]!)}
                  alt={x.copy[locale].title}
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
              <p class="scenario-tabs__example-label">{st.scenarios.exampleLabel}</p>
              <p class="scenario-tabs__example">{x.copy[locale].example}</p>
              <a class="scenario-tabs__link" href={`${r("solutions")}#scenario-${x.id}`}>{dc.labels.details} <span aria-hidden="true">→</span></a>
            </section>
          ))}
        </div>
      </div>
      <p class="home-scn__all"><a class="btn btn--soft-blue" href={`${r("solutions")}#scenarios`}>{st.scenarios.linkAll}</a></p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-solutions-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!track || !previous || !next) return;

    const updateButtons = () => {
      previous.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    const scrollByCard = (direction: -1 | 1) => {
      const card = track.querySelector<HTMLElement>(".scard");
      if (!card) return;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({
        left: direction * (card.getBoundingClientRect().width + gap),
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      });
    };

    previous.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
    track.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>("[data-scenario-tabs]").forEach((tabs) => {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>("[data-scenario-tab]")];
    const panels = [...tabs.querySelectorAll<HTMLElement>("[data-scenario-panel]")];
    const tablist = tabs.querySelector<HTMLElement>("[role=tablist]");
    if (buttons.length === 0 || buttons.length !== panels.length || !tablist) return;
    const mobileLayout = matchMedia("(max-width: 767px)");
    const updateOrientation = () => tablist.setAttribute("aria-orientation", mobileLayout.matches ? "horizontal" : "vertical");
    updateOrientation();
    mobileLayout.addEventListener("change", updateOrientation);

    const activate = (index: number, focus = false) => {
      buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === index;
        button.setAttribute("aria-selected", String(active));
        button.tabIndex = active ? 0 : -1;
        button.classList.toggle("is-active", active);
      });
      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.remove("is-visible");
        if (active) requestAnimationFrame(() => panel.classList.add("is-visible"));
      });
      if (focus) buttons[index]?.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => activate(index));
      button.addEventListener("keydown", (event) => {
        let nextIndex = index;
        const forwardKey = mobileLayout.matches ? "ArrowRight" : "ArrowDown";
        const backwardKey = mobileLayout.matches ? "ArrowLeft" : "ArrowUp";
        if (event.key === forwardKey) nextIndex = (index + 1) % buttons.length;
        else if (event.key === backwardKey) nextIndex = (index - 1 + buttons.length) % buttons.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = buttons.length - 1;
        else return;
        event.preventDefault();
        activate(nextIndex, true);
      });
    });
    activate(0);
  });
</script>

<!-- PROJECTS -->
<section class="section sec-projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="projects-title">{ps.home.heading}</h2>
      <p class="section-heading__lead">{ps.home.lead}</p>
    </div>
    <div class="project-carousel" data-project-carousel>
      <div class="project-carousel__layout">
        <button class="project-carousel__arrow project-carousel__arrow--previous" type="button" data-project-prev aria-label={projectCarouselLabels.previous}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <div class="project-carousel__track" data-project-track role="region" aria-label={ps.home.heading} tabindex="0">
          {featuredProjects.map((p, index) => (
            <div class:list={["project-carousel__slide", index === 1 && "is-active"]} data-project-slide role="group" aria-roledescription="slide" aria-label={`${index + 1} / ${featuredProjects.length}`}>
              <ProjectCard locale={locale} project={p} featured />
            </div>
          ))}
        </div>
        <button class="project-carousel__arrow project-carousel__arrow--next" type="button" data-project-next aria-label={projectCarouselLabels.next}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
      <div class="project-carousel__pagination" data-project-pagination role="group" aria-label={projectCarouselLabels.pagination}>
        {featuredProjects.map((_, index) => (
          <button class="project-carousel__dot" type="button" data-project-dot aria-label={`${projectCarouselLabels.slide} ${index + 1}`} aria-pressed={index === 1 ? "true" : "false"}></button>
        ))}
      </div>
    </div>
    <p class="sec-projects__all"><a class="btn btn--soft-blue" href={r("lab")}>{ps.labels.allProjects}</a></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-project-track]");
    const slides = [...carousel.querySelectorAll<HTMLElement>("[data-project-slide]")];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>("[data-project-dot]")];
    const previous = carousel.querySelector<HTMLButtonElement>("[data-project-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-project-next]");
    if (!track || slides.length === 0 || slides.length !== dots.length) return;

    let activeIndex = -1;
    const updateActiveSlide = () => {
      const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;
      slides.forEach((slide, index) => {
        const bounds = slide.getBoundingClientRect();
        const distance = Math.abs(bounds.left + bounds.width / 2 - trackCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });
      if (closestIndex === activeIndex) return;
      activeIndex = closestIndex;
      slides.forEach((slide, index) => slide.classList.toggle("is-active", index === activeIndex));
      dots.forEach((dot, index) => dot.setAttribute("aria-pressed", String(index === activeIndex)));
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === slides.length - 1;
    };

    const centerSlide = (index: number, behavior?: ScrollBehavior) => {
      const slide = slides[index];
      if (!slide) return;
      const trackBounds = track.getBoundingClientRect();
      const slideBounds = slide.getBoundingClientRect();
      const slideCenter = slideBounds.left + slideBounds.width / 2;
      const left = track.scrollLeft + slideCenter - (trackBounds.left + track.clientWidth / 2);
      track.scrollTo({ left, behavior: behavior ?? (matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth") });
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => centerSlide(index)));
    previous?.addEventListener("click", () => centerSlide(Math.max(0, activeIndex - 1)));
    next?.addEventListener("click", () => centerSlide(Math.min(slides.length - 1, activeIndex + 1)));
    track.addEventListener("scroll", updateActiveSlide, { passive: true });
    window.addEventListener("resize", updateActiveSlide);
    centerSlide(Math.min(1, slides.length - 1), "auto");
    updateActiveSlide();
  });
</script>

<!-- LOCAL / PRIVATE AI -->
<section class="section sec-local dark-section" aria-labelledby="local-title">
  <div class="container sec-local__grid">
    <div>
      <h2 id="local-title">{h.localAi.heading}</h2>
      <p class="sec-local__lead">{h.localAi.lead}</p>
      <p class="sec-local__caution">{h.localAi.caution}</p>
      <p class="sec-local__links">
        <a class="btn btn--inverse" href={r("localAi")}>{h.localAi.cta}</a>
        <a href={r("labAutoLlmBenchmark")}>{h.localAi.linkBenchmark}</a>
        <a href={r("labLocalTranscription")}>{h.localAi.linkTranscription}</a>
      </p>
    </div>
    <div class="sec-local__panel">
      <ol class="flow flow--dark" aria-label={h.localAi.diagramLabel}>
        {h.localAi.flow.map((step) => <li>{step}</li>)}
      </ol>
      <div class="sec-local__cols">
        <div>
          <h3>{h.localAi.supportedHeading}</h3>
          <ul>{h.localAi.supported.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div>
          <h3>{h.localAi.developingHeading}</h3>
          <ul>{h.localAi.developing.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AUDIENCES -->
<section class="section sec-aud" aria-labelledby="aud-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="aud-title">{h.audiences.heading}</h2>
      <p class="section-heading__lead">{h.audiences.lead}</p>
    </div>
    <div class="aud-grid">
      <article class="acard">
        <span class="acard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"/></svg>
        </span>
        <h3>{h.audiences.business.title}</h3>

        <a class="acard__overlay-link" href={r("business")} aria-label={`${h.audiences.link}: ${h.audiences.business.title}`}></a>
      </article>
      <article class="acard">
        <span class="acard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 10-5 10 5-10 5L2 9Z"/><path d="M6 11v5c3.5 3 8.5 3 12 0v-5M22 9v6"/></svg>
        </span>
        <h3>{h.audiences.education.title}</h3>
        <p>{h.audiences.education.text}</p>
        <a class="acard__overlay-link" href={r("education")} aria-label={`${h.audiences.link}: ${h.audiences.education.title}`}></a>
      </article>
      <article class="acard">
        <span class="acard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4M8 10h.01M12 10h.01M16 10h.01M8 13h.01M12 13h.01M16 13h.01"/></svg>
        </span>
        <h3>{h.audiences.publicSector.title}</h3>
        <p>{h.audiences.publicSector.text}</p>
        <a class="acard__overlay-link" href={r("publicSector")} aria-label={`${h.audiences.link}: ${h.audiences.publicSector.title}`}></a>
      </article>
    </div>

---
import { Image } from "astro:assets";
import heroArt from "../../assets/hero-background-white.jpg";
import heroLeftArt from "../../assets/hero-left-fade.png";
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/translations/index";
import { namedRoute } from "../../lib/routes";
import { TELEGRAM_URL } from "../../config/site";
import AspFindModal from "../asp-find/AspFindModal.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const hero = dict.home.hero;
const route = (key: Parameters<typeof namedRoute>[0]) => namedRoute(key, locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__image-background hero__image-background--left" aria-hidden="true">
    <Image src={heroLeftArt} alt="" width={628} height={945} loading="eager" format="webp" quality={84} sizes="(min-width: 1478px) 680px, 42vw" />
  </div>
  <div class="hero__image-background" aria-hidden="true">
    <Image src={heroArt} alt="" width={2752} height={1536} loading="eager" fetchpriority="high" format="webp" quality={84} sizes="(min-width: 1024px) 65vw, 100vw" />
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        <span>{hero.headingPrefix}{hero.headingFirstRest}</span>
        <br />
        <span>{hero.headingSecond}</span>
      </h1>
      <p class="hero__lead"><strong>ASP Lab</strong>{hero.lead.replace(/^ASP Lab/, "")}</p>
      <p class="hero__audience">{hero.audience}</p>
      <div class="hero__actions">
        <div class="hero__actions-primary">
          <button class="btn btn--primary" type="button" aria-haspopup="dialog" aria-controls="finder-modal" data-finder-open>{hero.cta}</button>
          <a class="btn btn--secondary hero__projects-link" href={route("lab")}>{hero.ctaSecondary}<span aria-hidden="true">→</span></a>
        </div>
        <div class="hero__actions-secondary">
          <a class="hero__telegram-link" href={TELEGRAM_URL ?? route("contact")} target={TELEGRAM_URL ? "_blank" : undefined} rel={TELEGRAM_URL ? "noopener noreferrer" : undefined}>
            <svg class="hero__telegram-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.6 18.7 19.7c-.2 1.1-.8 1.4-1.7.9l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1.1.5l.4-4.8 8.8-7.9c.4-.4-.1-.6-.6-.2L6.6 13.8l-4.6-1.4c-1-.3-1.1-1 .2-1.5L20.5 3.8c.9-.3 1.7.2 1.4.8Z" /></svg>
            {hero.telegramCta}
            {TELEGRAM_URL && <span class="sr-only"> ({dict.ui.telegram.external})</span>}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<AspFindModal locale={locale} />

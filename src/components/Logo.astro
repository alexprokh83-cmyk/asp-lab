---
/** Owner-provided logo variants for the header, compact mark and footer. */
type LogoVariant = "main" | "compact" | "footer";
interface Props { height?: number; class?: string; variant?: LogoVariant; alt?: string }
const { height = 48, class: className = "", variant = "main", alt = "ASP Lab" } = Astro.props;
const main = { src: "/logo/asp-lab-logo-wide.svg", width: 520, height: 180 };
const compact = { src: "/logo/asp-lab-logo-compact.jpg", width: 682, height: 629 };
const footer = { src: "/logo/asp-lab-logo-footer.jpg", width: 686, height: 858 };
const asset = variant === "footer" ? footer : variant === "compact" ? compact : main;
const width = Math.round((height * asset.width) / asset.height);
---
<span class:list={["logo", className]}>
  <img src={asset.src} alt={alt} width={width} height={height} class="logo__img" decoding="async" style={variant === "main" ? undefined : `height:${height}px;width:auto;`} />
</span>

<style>
  .logo { display: inline-flex; align-items: center; line-height: 0; }
  .logo__img { display: block; max-width: 100%; object-fit: contain; }
  .logo--header .logo__img { height: 48px; width: auto; }
  @media (min-width: 768px) and (max-width: 1199px) { .logo--header .logo__img { height: 40px; } }
  @media (max-width: 767px) { .logo--header .logo__img { height: 32px; } }
  .logo--mobile-menu .logo__img { height: 40px; width: auto; }
</style>

---
/**
 * Single source of Telegram contact behaviour.
 * Configured → real external link. Unconfigured → honest unavailable state
 * (never href="#", never an invented t.me address).
 */
import type { Locale } from "../lib/i18n";
import { t } from "../lib/translations/index";
import { TELEGRAM_URL } from "../config/site";
import { namedRoute } from "../lib/routes";

interface Props { locale: Locale; label: string; tone?: "primary" | "inverse" | "outline"; showIcon?: boolean; showContactLink?: boolean }
const { locale, label, tone = "primary", showIcon = false, showContactLink = true } = Astro.props;
const dict = t(locale);
---
{TELEGRAM_URL ? (
  <div class="tg">
    <a class:list={["btn", tone === "inverse" ? "btn--inverse" : tone === "outline" ? "btn--outline" : "btn--primary"]} href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">
      {showIcon && <svg class="tg__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.6 18.7 19.7c-.2 1.1-.8 1.4-1.7.9l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1.1.5l.4-4.8 8.8-7.9c.4-.4-.1-.6-.6-.2L6.6 13.8l-4.6-1.4c-1-.3-1.1-1 .2-1.5L20.5 3.8c.9-.3 1.7.2 1.4.8Z" /></svg>}
      {label}<span class="sr-only"> ({dict.ui.telegram.external})</span>
    </a>
  </div>
) : (
  <div class="tg tg--off">
    <p class="tg__off-title"><span class="tg__dot" aria-hidden="true"></span>{dict.ui.telegram.unavailable}</p>
    <p class="tg__off-note">{dict.ui.telegram.unavailableNote}</p>
    {showContactLink && <a class="tg__contact" href={namedRoute("contact", locale)}>{dict.nav.cta}</a>}
  </div>
)}
